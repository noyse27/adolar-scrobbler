# Postgres password used by both the db and app containers
POSTGRES_PASSWORD=change-me

# Long random secrets — generate e.g. with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string

# The externally reachable URL of this instance (used in legacy scrobbler
# handshake responses). Set this to your real domain once you put a reverse
# proxy in front, e.g. https://scrobbler.example.com
PUBLIC_URL=http://localhost:4000

# Whether new users can self-register
ALLOW_REGISTRATION=true

# Host port to publish the app on
HOST_PORT=4000
