# Postgres password used by both the db and app containers
POSTGRES_PASSWORD=change-me

# Long random secrets — generate e.g. with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECRET=change-me-to-another-long-random-string

# One-time token required to create the very first (admin) account. Generated
# automatically by setup.sh. Enter it on the registration page when setting
# up this instance for the first time; it has no effect after that.
SETUP_TOKEN=change-me-to-a-long-random-string

# The externally reachable URL of this instance (used in legacy scrobbler
# handshake responses). Set this to your real domain once you put a reverse
# proxy in front, e.g. https://scrobbler.example.com
PUBLIC_URL=http://localhost:4000

# Whether new users can self-register through the login screen without an
# invite link. Off by default — admins can also flip this at runtime from
# Settings once logged in, without restarting anything. Registration via an
# invite link always works regardless of this setting.
ALLOW_REGISTRATION=false

# Host port to publish the app on
HOST_PORT=4000

# Optional asynchronous metadata enrichment. Set a public URL or contact
# address so MusicBrainz can reach the instance maintainer if necessary.
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_CONTACT=https://example.com/contact
