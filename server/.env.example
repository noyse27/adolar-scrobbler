DATABASE_URL=postgresql://adolar:adolar@localhost:5432/adolar_scrobbler
JWT_SECRET=dev-secret-change-me
COOKIE_SECRET=dev-cookie-secret-change-me
PUBLIC_URL=http://localhost:4000
# Leave SETUP_TOKEN unset for local dev — bootstrap (the first account) is
# then unguarded, which is convenient when nothing is reachable but you.
SETUP_TOKEN=
ALLOW_REGISTRATION=false
MUSICBRAINZ_ENABLED=true
MUSICBRAINZ_CONTACT=https://example.com/contact
COVER_CACHE_DIR=./data/covers
PORT=4000
